# 0 = localhost; 1 = domínio; 2 = ambos.
ACCESS_MODE=0

# Modelo para Cloudflare Tunnel no Windows. Veja docs/CLOUDFLARE.md.
# O domínio precisa estar registrado por você e ativo no DNS da Cloudflare.
PORTAL_HOST=<seu-dominio-aqui> # Ex.: meudominio.com.br
CHALLENGE_HOST=<seu-dominio-aqui> # Ex.: meudominio.com.br
MAP_HOST=mapa.<seu-dominio-aqui>

# cloudflared instalado no Windows acessa somente o gateway local.
ORACLE_BIND=127.0.0.1
ORACLE_PORT=8080
PUBLIC_PORT=443
PUBLIC_SCHEME=https
COOKIE_SECURE=1

# Sessão deslizante do portal, em segundos (6 horas).
SESSION_TTL=21600

# Intervalo (ms) com que a Guardiã das Marés (bot do desafio Água) revisa os reflexos.
GUARDIA_INTERVAL_MS=4000
# Quantidade de jogadores que a gaurdia atende ao mesmo tempo.
# Default = 2; É aceito de 1 a 8.
# 
# Supondo 20 visitas pendentes e 5 segundos por visita:
# Concorrência	Tempo aproximado para processar as visitas
# 1	            100 segundos
# 2	            50 segundos
# 4	            25 segundos
# etc ...
#
# Obs: Isso afeta o tempo em que a consulta vai para a guardiã. o espelho.
GUARDIA_CONCURRENCY=4

# Preencha com valores próprios. Não são necessários tokens Cloudflare no jogo.
# Em bancos já inicializados, preserve as senhas atuais.
DB_PASSWORD=<senha-para-base-de-dados>
DB_ROOT_PASSWORD=<senha-para-base-de-dados-root>
EARTH_DB_ROOT_PASSWORD=<senha-para-base-de-dados-root-5earth>

# Segredo interno entre o desafio Água e a Guardiã (bot). Só o servidor conhece;
# protege a página de moderação da Guardiã (não deve ser alcançável pelo jogador).
WATER_BOT_TOKEN=<token-qualquer-coisa-minimo-16-caracteres> #Ex quick-start.: b42d6b130ce6f414f336cd5f7263006aa9ed25ff6a4f5826fca0d689adc2e862

# ACCOUNT_SECRET assina os ingressos dos desafios e as sessões do Fire,
# deriva as flags individuais e seleciona o Nome do Espírito de cada conta.
# Mantenha-o somente no servidor e use pelo menos 32 caracteres aleatórios.
ACCOUNT_SECRET=<token-qualquer-coisa-minimo-32-caracteres> # Ex quick-start.: 90bf07358cf53ae21bed5cead2fb9dafd30d1f98e52c71c05ecdfdfac4858386
